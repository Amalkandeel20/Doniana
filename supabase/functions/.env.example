# Edge Function secrets for `supabase functions serve --env-file supabase/functions/.env`.
# In hosted projects set these with `supabase secrets set` (see docs/DEPLOYMENT.md).
APP_ENV=development
SITE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# openssl rand -base64 48
MANAGE_TOKEN_SECRET=
RATE_LIMIT_SALT=
CRON_SECRET=
# dev | twilio
SMS_PROVIDER=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
SMS_STATUS_CALLBACK_URL=
# Optional Cloudflare Turnstile (anti-bot). Leave empty to disable.
TURNSTILE_SECRET_KEY=
