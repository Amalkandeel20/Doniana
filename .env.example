# Frontend build-time variables (public — they end up in the browser bundle).
# NEVER put the service-role key or any secret here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Optional: Cloudflare Turnstile site key (public). Leave empty to disable the widget.
VITE_TURNSTILE_SITE_KEY=
VITE_APP_ENV=development
